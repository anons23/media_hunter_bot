@router.callback_query(F.data.startswith("ch_wm_"))
async def channel_watermark_toggle(call: CallbackQuery, state: FSMContext):
    data = call.data
    m = re.match(r"^ch_wm_(\d+)_(set_text|toggle_pos|toggle_color|toggle_size|toggle_opacity|preview_image)$", data)
    if not m:
        return
    ch_id = int(m.group(1))
    action = m.group(2)
    row = await db_query(
        """SELECT wm_text, wm_position, wm_color, wm_font_size, wm_opacity, channel_name
           FROM channels WHERE id = ? AND user_id = ?""",
        (ch_id, call.from_user.id), fetchone=True
    )
    if not row:
        await call.answer("Канал не найден", show_alert=True)
        return
    if action == "set_text":
        await state.set_state(UserStates.waiting_for_channel_wm_text)
        await state.update_data(channel_db_id=ch_id)
        await call.answer()
        await call.message.edit_text(
            "✍️ **Введите текст водяного знака канала (до 30 символов):**\n\n◀️ Для отмены используйте /start",
            parse_mode="Markdown"
        )
        return
    if action == "preview_image":
        if not HAS_PIL:
            await call.answer("Pillow не установлен", show_alert=True)
            return
        buf = await asyncio.to_thread(generate_watermark_preview, *row[:5])
        await call.message.answer_photo(
            BufferedInputFile(buf.getvalue(), filename="channel_preview.jpg"),
            caption="🖼 Предпросмотр водяного знака канала"
        )
        await call.answer()
        return

    text, pos, color, size, opacity = row[:5]
    if action == "toggle_pos":
        vals = list(ALLOWED_WM_POSITIONS)
        # Стабильный порядок
        vals = ["top_left", "top_right", "bottom_left", "bottom_right", "center"]
        pos = vals[(vals.index(pos) + 1) % len(vals)] if pos in vals else vals[0]
    elif action == "toggle_color":
        vals = ["white", "yellow", "red", "green", "black"]
        color = vals[(vals.index(color) + 1) % len(vals)] if color in vals else vals[0]
    elif action == "toggle_size":
        vals = [20, 28, 36, 44]
        size = vals[(vals.index(int(size)) + 1) % len(vals)] if int(size) in vals else 28
    elif action == "toggle_opacity":
        vals = [0.5, 0.8, 1.0]
        opacity = vals[(vals.index(float(opacity)) + 1) % len(vals)] if float(opacity) in vals else 0.8

    await db_query(
        """UPDATE channels SET wm_position=?, wm_color=?, wm_font_size=?, wm_opacity=?
           WHERE id=? AND user_id=?""",
        (pos, color, size, opacity, ch_id, call.from_user.id), commit=True
    )
    new_wm = await db_query(
        "SELECT wm_text, wm_position, wm_color, wm_font_size, wm_opacity FROM channels WHERE id=? AND user_id=?",
        (ch_id, call.from_user.id), fetchone=True
    )
    await call.answer()
    await call.message.edit_reply_markup(
        reply_markup=get_watermark_keyboard(new_wm, is_channel=True, channel_db_id=ch_id)
    )

