def init_db():
    """Создание таблиц и безопасная миграция старой БД."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            registered_at TEXT,
            is_premium INTEGER DEFAULT 0,
            premium_until TEXT,
            referrals_count INTEGER DEFAULT 0,
            referred_by INTEGER
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS channels (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            channel_id TEXT NOT NULL,
            channel_name TEXT,
            auto_post INTEGER DEFAULT 1,
            wm_text TEXT DEFAULT 'Media Hunter',
            wm_position TEXT DEFAULT 'bottom_right',
            wm_color TEXT DEFAULT 'white',
            wm_font_size INTEGER DEFAULT 28,
            wm_opacity REAL DEFAULT 0.8,
            added_at TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS watermark_settings (
            user_id INTEGER PRIMARY KEY,
            text TEXT DEFAULT 'Media Hunter',
            position TEXT DEFAULT 'bottom_right',
            color TEXT DEFAULT 'white',
            font_size INTEGER DEFAULT 28,
            opacity REAL DEFAULT 0.8
        )
    """)

    # Миграция БД, если таблица была создана старой версией.
    existing = {row[1] for row in cursor.execute("PRAGMA table_info(channels)").fetchall()}
    migrations = {
        "auto_post": "INTEGER DEFAULT 1",
        "wm_text": "TEXT DEFAULT 'Media Hunter'",
        "wm_position": "TEXT DEFAULT 'bottom_right'",
        "wm_color": "TEXT DEFAULT 'white'",
        "wm_font_size": "INTEGER DEFAULT 28",
        "wm_opacity": "REAL DEFAULT 0.8",
        "added_at": "TEXT",
    }
    for column, definition in migrations.items():
        if column not in existing:
            cursor.execute(f"ALTER TABLE channels ADD COLUMN {column} {definition}")

    conn.commit()
    conn.close()
    logger.info("База данных SQLite успешно инициализирована/мигрирована.")

async def db_query(query: str, params: tuple = (), fetchone: bool = False, fetchall: bool = False, commit: bool = False) -> Any:
    """Безопасный асинхронный вызов SQLite в отдельном потоке."""
    def _execute():
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        cursor.execute(query, params)
        res = None
        if fetchone:
            res = cursor.fetchone()
        elif fetchall:
            res = cursor.fetchall()
        if commit:
            conn.commit()
        conn.close()
        return res

    return await asyncio.to_thread(_execute)

