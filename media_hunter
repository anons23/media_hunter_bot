    task = MediaTask(priority=priority, user_id=call.from_user.id, message_id=call.message.message_id, chat_id=call.message.chat.id, url=url, is_audio_only=is_audio)
    await task_queue.put(task)

async def queue_worker(bot: Bot, worker_id: int):
    """Фоновый воркер очереди. Несколько воркеров дают реальное ограничение параллелизма."""
    global active_tasks_count
    logger.info("Воркер %s запущен.", worker_id)

    while True:
        task: MediaTask = await task_queue.get()
        active_tasks_count += 1
        try:
            await bot.edit_message_text(
                "📥 Обработка медиафайла...",
                chat_id=task.chat_id, message_id=task.message_id
            )

            with tempfile.TemporaryDirectory(prefix="mediahunter_") as tmp_dir:
                filepath = None
                title = "Медиа файл"

                if task.direct_file_id:
                    tg_file = await bot.get_file(task.direct_file_id)
                    if not tg_file.file_path:
                        raise RuntimeError("Telegram не вернул путь к файлу.")
                    filepath = os.path.join(tmp_dir, "input_gallery")
                    await bot.download_file(tg_file.file_path, destination=filepath)
                elif task.url:
                    dl_result = await download_media(task.url, tmp_dir, extract_audio=task.is_audio_only)
                    if not dl_result:
                        await bot.edit_message_text(
                            "❌ Не удалось скачать файл по ссылке.",
                            chat_id=task.chat_id, message_id=task.message_id
                        )
                        continue
                    filepath = dl_result["filepath"]
                    title = dl_result["title"]

                if not filepath or not os.path.isfile(filepath):
                    raise FileNotFoundError("Исходный медиафайл отсутствует.")

                if task.is_audio_only:
                    await bot.send_audio(
                        chat_id=task.chat_id, audio=FSInputFile(filepath),
                        caption=f"🎵 {escape_markdown(title)}", parse_mode="Markdown"
                    )
                    await bot.delete_message(chat_id=task.chat_id, message_id=task.message_id)
                    continue

                wm_settings = await db_query(
                    "SELECT text, position, color, font_size, opacity FROM watermark_settings WHERE user_id = ?",
                    (task.user_id,), fetchone=True
                ) or ("Media Hunter", "bottom_right", "white", 28, 0.8)
                wm_settings = normalize_wm_settings(wm_settings)

                out_file = os.path.join(tmp_dir, "processed.mp4")
                await bot.edit_message_text(
                    "🎨 Уникализация и водяной знак...",
                    chat_id=task.chat_id, message_id=task.message_id
                )
                success = await process_video_ffmpeg(filepath, out_file, wm_settings)
                final_send_path = out_file if success else filepath

                if os.path.getsize(final_send_path) > MAX_RENDER_SIZE_MB * 1024 * 1024:
                    raise ValueError(f"Результат больше лимита Telegram ({MAX_RENDER_SIZE_MB} МБ).")

                await bot.send_video(
                    chat_id=task.chat_id,
                    video=FSInputFile(final_send_path),
                    caption=f"✅ **Готово!**\n🎬 {escape_markdown(title)}",
                    parse_mode="Markdown"
                )
                await bot.delete_message(chat_id=task.chat_id, message_id=task.message_id)

                # Для каждого канала используем его собственный watermark.
                active_channels = await db_query(
                    """SELECT id, channel_id, wm_text, wm_position, wm_color, wm_font_size, wm_opacity
                       FROM channels WHERE user_id = ? AND auto_post = 1""",
                    (task.user_id,), fetchall=True
                )
                for ch in active_channels:
                    ch_db_id, ch_id, *ch_wm = ch
                    try:
                        channel_file = final_send_path
                        if ch_wm and tuple(ch_wm) != tuple(wm_settings):
                            channel_file = os.path.join(tmp_dir, f"channel_{ch_db_id}.mp4")
                            ch_success = await process_video_ffmpeg(
                                filepath, channel_file, normalize_wm_settings(tuple(ch_wm))
                            )
                            if not ch_success:
                                channel_file = final_send_path
                        await bot.send_video(
                            chat_id=ch_id,
                            video=FSInputFile(channel_file),
                            caption=f"🎬 {escape_markdown(title)}",
                            parse_mode="Markdown"
                        )
                    except Exception as post_err:
                        logger.error("Ошибка автопостинга в канал %s: %s", ch_id, post_err)

        except Exception as e:
            logger.exception("Ошибка выполнения задачи: %s", e)
            try:
                await bot.edit_message_text(
                    "❌ Произошла ошибка обработки. Проверьте ссылку/размер файла и наличие FFmpeg.",
                    chat_id=task.chat_id, message_id=task.message_id
                )
            except Exception:
                pass
        finally:
            active_tasks_count = max(0, active_tasks_count - 1)
            task_queue.task_done()

async def main():
    if BOT_TOKEN == "YOUR_TELEGRAM_BOT_TOKEN_HERE":
        logger.critical("Укажите BOT_TOKEN в переменных окружения или файле!")
        return

    init_db()
    bot = Bot(token=BOT_TOKEN)
    dp = Dispatcher(storage=MemoryStorage())
    dp.include_router(router)

    for worker_id in range(1, MAX_CONCURRENT_DOWNLOADS + 1):
        asyncio.create_task(queue_worker(bot, worker_id))
    logger.info("Media Hunter Bot успешно запущен!")
    
    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        logger.info("Бот остановлен.")
  
