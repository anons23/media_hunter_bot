        colors = ["white", "yellow", "red", "green", "black"]
        val = colors[(colors.index(wm[2]) + 1) % len(colors)]
        await db_query("UPDATE watermark_settings SET color = ? WHERE user_id = ?", (val, user_id), commit=True)
