ALLOWED_WM_POSITIONS = {"top_left", "top_right", "bottom_left", "bottom_right", "center"}
ALLOWED_WM_COLORS = {"white", "yellow", "red", "green", "black"}
ALLOWED_WM_SIZES = {20, 28, 36, 44}
ALLOWED_WM_OPACITIES = {0.5, 0.8, 1.0}

def escape_markdown(text: str) -> str:
    """Минимально безопасный Markdown-экранирование динамического текста."""
    return re.sub(r'([\\_*`\[\]])', r'\\\1', str(text or ""))

def ffmpeg_drawtext_escape(text: str) -> str:
    """Экранирует текст для FFmpeg drawtext."""
    return (
        str(text or "")
        .replace("\\", r"\\")
        .replace("'", r"\'")
        .replace(":", r"\:")
        .replace("%", r"\%")
        .replace("[", r"\[")
        .replace("]", r"\]")
        .replace("\n", r"\n")
    )

def ffmpeg_filter_escape_path(path: str) -> str:
    """Экранирует путь для параметра fontfile фильтра FFmpeg."""
    return (
        path.replace("\\", r"\\")
            .replace(":", r"\:")
            .replace("'", r"\'")
            .replace("[", r"\[")
            .replace("]", r"\]")
            .replace(",", r"\,")
    )

def normalize_wm_settings(wm: tuple) -> tuple:
    """Защищает FFmpeg/Pillow от некорректных значений из старой БД."""
    text = str(wm[0] or "Media Hunter")[:30]
    pos = wm[1] if wm[1] in ALLOWED_WM_POSITIONS else "bottom_right"
    color = wm[2] if wm[2] in ALLOWED_WM_COLORS else "white"
    try:
        size = int(wm[3])
    except (TypeError, ValueError):
        size = 28
    if size not in ALLOWED_WM_SIZES:
        size = min(ALLOWED_WM_SIZES, key=lambda x: abs(x - size))
    try:
        opacity = float(wm[4])
    except (TypeError, ValueError):
        opacity = 0.8
    opacity = min(1.0, max(0.1, opacity))
    return text, pos, color, size, opacity

def validate_url(url: str) -> bool:
    return bool(re.match(r"^https?://[^\s]+$", url or "", re.IGNORECASE))

