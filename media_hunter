@router.callback_query(F.data.startswith("dl_vid_") | F.data.startswith("dl_aud_"))
async def start_link_download(call: CallbackQuery):
    await call.answer()
    is_audio = call.data.startswith("dl_aud_")
    # Do not use callback_data as the source of access-control information.
    await ensure_user(call.from_user.id, call.from_user.username or "User")
    priority = 0 if await is_user_premium(call.from_user.id) else 1
    
