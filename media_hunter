def generate_watermark_preview(text: str, pos: str, color: str, size: int, opacity: float) -> BytesIO:
    """Создание фото-образца для виртуального предпросмотра наложенного водяного знака."""
    if not HAS_PIL:
        raise RuntimeError("Pillow не установлен. Установите pillow.")
    text, pos, color, size, opacity = normalize_wm_settings((text, pos, color, size, opacity))
    width, height = 800, 450
    img = Image.new("RGBA", (width, height), (30, 33, 36, 255))
    draw = ImageDraw.Draw(img)

    for x in range(0, width, 40):
        draw.line([(x, 0), (x, height)], fill=(45, 49, 54, 255), width=1)
    for y in range(0, height, 40):
        draw.line([(0, y), (width, y)], fill=(45, 49, 54, 255), width=1)

    try:
        title_font = ImageFont.truetype(FONT_PATH, 22)
        wm_font = ImageFont.truetype(FONT_PATH, size)
    except Exception:
        title_font = ImageFont.load_default()
        wm_font = ImageFont.load_default()

    draw.text((width // 2, height // 2), "ОБРАЗЕЦ ВИДЕОКАДРА", fill=(110, 115, 125, 255), anchor="mm", font=title_font)

    color_map = {
        "white": (255, 255, 255), "yellow": (255, 223, 0),
        "red": (235, 64, 52), "green": (52, 205, 88), "black": (0, 0, 0)
    }
    rgb = color_map.get(color, (255, 255, 255))
    rgba_color = (rgb[0], rgb[1], rgb[2], int(opacity * 255))

    padding = 20
    pos_coords = {
        "top_left": (padding, padding), "top_right": (width - padding, padding),
        "bottom_left": (padding, height - padding), "bottom_right": (width - padding, height - padding),
        "center": (width // 2, height // 2)
    }
    anchor_map = {
        "top_left": "la", "top_right": "ra",
        "bottom_left": "lb", "bottom_right": "rb", "center": "mm"
    }

    coord = pos_coords.get(pos, (width - padding, height - padding))
    anc = anchor_map.get(pos, "rb")

    text_layer = Image.new("RGBA", (width, height), (0, 0, 0, 0))
    text_draw = ImageDraw.Draw(text_layer)
    text_draw.text(coord, text, fill=rgba_color, font=wm_font, anchor=anc)

    combined = Image.alpha_composite(img, text_layer)
    output = BytesIO()
    combined.convert("RGB").save(output, format="JPEG", quality=90)
    output.seek(0)
    return output

async def process_video_ffmpeg(input_path: str, output_path: str, wm_settings: tuple) -> bool:
    """Обработка видео через FFmpeg с безопасным drawtext."""
    wm_text, pos, color, font_size, opacity = normalize_wm_settings(wm_settings)

    if not shutil.which("ffmpeg"):
        logger.error("FFmpeg не найден в PATH.")
        return False
    if not os.path.isfile(input_path):
        logger.error("Входной файл не найден: %s", input_path)
        return False

    pos_map = {
        "top_left": "x=15:y=15",
        "top_right": "x=w-tw-15:y=15",
        "bottom_left": "x=15:y=h-th-15",
        "bottom_right": "x=w-tw-15:y=h-th-15",
        "center": "x=(w-tw)/2:y=(h-th)/2",
    }
    coord = pos_map.get(pos, pos_map["bottom_right"])
    color_param = f"{color}@{opacity:.3f}"
    text_escaped = ffmpeg_drawtext_escape(wm_text)
    font_escaped = ffmpeg_filter_escape_path(FONT_PATH)

    filter_complex = (
        f"eq=brightness=0.01:saturation=1.02,"
        f"drawtext=text='{text_escaped}':fontfile='{font_escaped}':"
        f"fontsize={font_size}:fontcolor={color_param}:{coord}"
    )

    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
        "-i", input_path,
        "-vf", filter_complex,
        "-c:v", "libx264",
        "-preset", "veryfast",
        "-crf", "26",
        "-c:a", "aac",
        "-b:a", "128k",
        "-movflags", "+faststart",
        output_path,
    ]

    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
        _, stderr = await proc.communicate()
        if proc.returncode != 0:
            logger.error("FFmpeg error: %s", stderr.decode(errors="replace")[-5000:])
            return False
        if not os.path.isfile(output_path) or os.path.getsize(output_path) == 0:
            logger.error("FFmpeg завершился без выходного файла.")
            return False
        return True
    except Exception:
        logger.exception("Исключение при вызове FFmpeg")
        return False

async def download_media(url: str, output_dir: str, extract_audio: bool = False) -> Optional[Dict[str, Any]]:
    """Скачивание медиа через yt-dlp с проверкой длительности и размера."""
    if not validate_url(url):
        logger.warning("Отклонена некорректная URL: %s", url)
        return None
    if not shutil.which("ffmpeg") and extract_audio:
        logger.error("Для извлечения MP3 требуется FFmpeg.")
        return None

    out_template = os.path.join(output_dir, "downloaded_media.%(ext)s")
    if extract_audio:
        ydl_opts = {
            "format": "bestaudio/best",
            "outtmpl": os.path.join(output_dir, "audio.%(ext)s"),
            "postprocessors": [{
                "key": "FFmpegExtractAudio",
                "preferredcodec": "mp3",
                "preferredquality": "192",
            }],
            "quiet": True,
            "no_warnings": True,
            "noplaylist": True,
        }
    else:
        ydl_opts = {
            "format": "bestvideo[ext=mp4][vcodec^=avc1]+bestaudio[ext=m4a]/best[ext=mp4]/best",
            "outtmpl": out_template,
            "quiet": True,
            "no_warnings": True,
            "noplaylist": True,
            "merge_output_format": "mp4",
        }

    if os.path.exists(COOKIES_PATH):
        ydl_opts["cookiefile"] = COOKIES_PATH

    def _extract_and_download():
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if not info:
                return None
            duration = float(info.get("duration") or 0)
            if duration > MAX_VIDEO_DURATION_MINUTES * 60:
                raise ValueError(f"Видео превышает лимит ({MAX_VIDEO_DURATION_MINUTES} мин).")

            downloaded_info = ydl.extract_info(url, download=True)
            if not downloaded_info:
                return None
            if "entries" in downloaded_info:
                entries = [x for x in (downloaded_info.get("entries") or []) if x]
                if not entries:
                    return None
                downloaded_info = entries[0]

            if extract_audio:
                filename = os.path.join(output_dir, "audio.mp3")
                if not os.path.isfile(filename):
                    # yt-dlp может выбрать другой исходный ext; ищем итоговый mp3.
                    mp3s = [os.path.join(output_dir, x) for x in os.listdir(output_dir) if x.lower().endswith(".mp3")]
                    if mp3s:
                        filename = mp3s[0]
            else:
                filename = ydl.prepare_filename(downloaded_info)
                if not os.path.isfile(filename):
                    candidates = [
                        os.path.join(output_dir, x) for x in os.listdir(output_dir)
                        if os.path.isfile(os.path.join(output_dir, x))
                    ]
                    if candidates:
                        filename = max(candidates, key=os.path.getsize)

            if not os.path.isfile(filename):
                raise FileNotFoundError("yt-dlp не создал ожидаемый файл.")

            actual_size_mb = os.path.getsize(filename) / (1024 * 1024)
            if actual_size_mb > MAX_RENDER_SIZE_MB:
                raise ValueError(f"Файл слишком большой: {actual_size_mb:.1f} МБ (лимит {MAX_RENDER_SIZE_MB} МБ).")

            return {
                "filepath": filename,
                "title": downloaded_info.get("title", "Медиа файл"),
                "duration": duration,
                "size_mb": actual_size_mb,
            }

    try:
        return await asyncio.to_thread(_extract_and_download)
    except Exception as e:
        logger.error("Ошибка загрузки через yt-dlp: %s", e)
        return None

