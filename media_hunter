@router.callback_query(F.data.startswith("wm_toggle_"))
async def toggle_wm_options(call: CallbackQuery):
    action = call.data.replace("wm_toggle_", "")
    user_id = call.from_user.id
    wm = await db_query("SELECT text, position, color, font_size, opacity FROM watermark_settings WHERE user_id = ?", (user_id,), fetchone=True)
    if not wm: wm = ("Media Hunter", "bottom_right", "white", 28, 0.8)

    if action == "pos":
        positions = ["top_left", "top_right", "bottom_left", "bottom_right", "center"]
        val = positions[(positions.index(wm[1]) + 1) % len(positions)]
        await db_query("UPDATE watermark_settings SET position = ? WHERE user_id = ?", (val, user_id), commit=True)
