@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    user_id = message.from_user.id
    username = message.from_user.username or "Пользователь"
    args = message.text.split(maxsplit=1)
    
    referrer_id = None
    if len(args) > 1 and args[1].startswith("ref_"):
        try:
            referrer_id = int(args[1].replace("ref_", ""))
            if referrer_id == user_id: referrer_id = None
        except ValueError: referrer_id = None

    existing = await db_query("SELECT user_id FROM users WHERE user_id = ?", (user_id,), fetchone=True)
    if not existing:
        now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        await db_query("INSERT INTO users (user_id, username, registered_at, referred_by) VALUES (?, ?, ?, ?)",
                       (user_id, username, now_str, referrer_id), commit=True)
        await db_query("INSERT OR IGNORE INTO watermark_settings (user_id) VALUES (?)", (user_id,), commit=True)

        if referrer_id:
            await db_query("UPDATE users SET referrals_count = referrals_count + 1 WHERE user_id = ?", (referrer_id,), commit=True)

    is_prem = await is_user_premium(user_id)
    text = (
        f"👋 **Привет, {message.from_user.first_name}!**\n\n"
        f"🚀 **Media Hunter** — бот для скачивания и уникализации видео из **YouTube**, **Instagram** и **TikTok**!\n\n"
        f"💡 **Что умеет бот?**\n"
        f"1. Скачивать видео по ссылкам или извлекать **MP3** аудио.\n"
        f"2. Обрабатывать загруженные из галереи видео до 80 МБ.\n"
        f"3. Накладывать уникальный водяной знак с тонкой настройкой.\n"
        f"4. Автопостинг в ваши Telegram-каналы!\n\n"
        f"👇 *Просто отправьте мне ссылку на ролик или видеофайл из галереи:* "
    )
    await message.answer(text, reply_markup=get_main_keyboard(user_id, is_prem), parse_mode="Markdown")

