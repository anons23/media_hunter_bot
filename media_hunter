@router.message(UserStates.waiting_for_channel_id)
async def save_channel_id(message: Message, state: FSMContext):
    if not message.text:
        await message.reply("⚠️ Отправьте @username или числовой ID канала.")
        return

    ch_input = message.text.strip()
    if not (ch_input.startswith("@") or re.fullmatch(r"-100\d{5,20}", ch_input)):
        await message.reply("⚠️ Формат канала должен быть @username или -100xxxxxxxxxx.")
        return

    try:
        chat = await message.bot.get_chat(ch_input)
        me = await message.bot.get_me()
        member = await message.bot.get_chat_member(chat.id, me.id)
        if member.status not in ("administrator", "creator"):
            await message.reply("⚠️ Бот должен быть администратором канала с правом публикации.")
            return
        channel_name = chat.title or ch_input
        channel_id = str(chat.id)
    except Exception as e:
        logger.warning("Не удалось проверить канал %s: %s", ch_input, e)
        await message.reply(
            "❌ Не удалось получить канал. Проверьте ID/username и убедитесь, что бот добавлен в канал администратором."
        )
        return

    exists = await db_query(
        "SELECT id FROM channels WHERE user_id = ? AND channel_id = ?",
        (message.from_user.id, channel_id), fetchone=True
    )
    if exists:
        await state.clear()
        await message.answer("ℹ️ Этот канал уже привязан.", reply_markup=get_main_keyboard(message.from_user.id))
        return

    # Копируем текущий основной watermark как стартовые настройки канала.
    wm = await db_query(
        "SELECT text, position, color, font_size, opacity FROM watermark_settings WHERE user_id = ?",
        (message.from_user.id,), fetchone=True
    ) or ("Media Hunter", "bottom_right", "white", 28, 0.8)
    await db_query(
        """INSERT INTO channels
           (user_id, channel_id, channel_name, auto_post, wm_text, wm_position, wm_color, wm_font_size, wm_opacity, added_at)
           VALUES (?, ?, ?, 1, ?, ?, ?, ?, ?, ?)""",
        (message.from_user.id, channel_id, channel_name, *normalize_wm_settings(wm),
         datetime.now().strftime("%Y-%m-%d %H:%M:%S")),
        commit=True
    )
    await state.clear()
    await message.answer("✅ Канал успешно проверен и добавлен!", reply_markup=get_main_keyboard(message.from_user.id))

