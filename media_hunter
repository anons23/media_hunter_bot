            "INSERT INTO users (user_id, username, registered_at) VALUES (?, ?, ?)",
            (user_id, username or "Пользователь", datetime.now().strftime("%Y-%m-%d %H:%M:%S")),
            commit=True
        )
    await db_query("INSERT OR IGNORE INTO watermark_settings (user_id) VALUES (?)", (user_id,), commit=True)

async def is_user_premium(user_id: int) -> bool:
    """Проверка наличия Премиум статуса."""
    user = await db_query("SELECT is_premium, premium_until FROM users WHERE user_id = ?", (user_id,), fetchone=True)
    if not user:
        return False
    is_prem, until_str = user[0], user[1]
    if is_prem == 1:
        if until_str:
            try:
                until_dt = datetime.strptime(until_str, "%Y-%m-%d %H:%M:%S")
                if datetime.now() > until_dt:
                    await db_query("UPDATE users SET is_premium = 0 WHERE user_id = ?", (user_id,), commit=True)
                    return False
            except Exception:
                pass
        return True
    return False

