@router.message(F.video | F.document)
async def handle_direct_video_upload(message: Message):
    """Обработка прямого файла из галереи."""
    file = message.video or message.document
    if not file: return

    if file.file_size and file.file_size > MAX_RENDER_SIZE_MB * 1024 * 1024:
        await message.reply(f"⚠️ Размер файла превышает лимит {MAX_RENDER_SIZE_MB} МБ.")
        return
    if message.document:
        mime = (message.document.mime_type or "").lower()
        if not mime.startswith("video/"):
            await message.reply("⚠️ Документ не является видеофайлом. Отправьте MP4/MOV/MKV или видео как файл.")
            return

    user_id = message.from_user.id
    await ensure_user(user_id, message.from_user.username or "Пользователь")
    is_prem = await is_user_premium(user_id)
    priority = 0 if is_prem else 1

    msg = await message.reply("⏳ Видео из галереи получено! Добавлено в очередь уникализации...")
    task = MediaTask(priority=priority, user_id=user_id, message_id=msg.message_id, chat_id=message.chat.id, direct_file_id=file.file_id)
    await task_queue.put(task)

