# Required
BOT_TOKEN=
ADMIN_ID=

# Optional
MEDIA_HUNTER_HOME=
LOCAL_BOT_API=http://127.0.0.1:8081
# TeleAds ad network: SDK key from publisher.teleads.pro (empty = no ads)
TELEADS_SDK_KEY=
YTDLP_COOKIES=

# Mini App editors (plate + text watermark). Public HTTPS address that nginx
# proxies to WEBAPP_HOST:WEBAPP_PORT. Empty = old button settings.
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8090
# Plate upload limits (images use MAX_WATERMARK_MB)
MAX_LOGO_GIF_MB=10
MAX_LOGO_GIF_SECONDS=15

# Media policy
SOFT_UNIQUE_SIZE_MB=80
MAX_UNIQUE_SIZE_MB=100
# Optional compatibility override; defaults to MAX_UNIQUE_SIZE_MB
MAX_URL_LOGICAL_MB=100
# Absolute safety limit for source downloads
MAX_SOURCE_DOWNLOAD_MB=700
# Telegram uploads can be larger when using the local Bot API
MAX_USER_UPLOAD_MB=700
# > MAX_UNIQUE_SIZE_MB: no uniqueness. Up to this size the original is sent as is,
# above it the video is gently compressed (quality first).
ORIGINAL_SEND_MAX_MB=130
TELEGRAM_MAX_UPLOAD_MB=2000
# Gentle compression settings (> ORIGINAL_SEND_MAX_MB)
OVERSIZE_CRF=22
OVERSIZE_PRESET=veryfast
# 0 = use all CPU cores
OVERSIZE_THREADS=0
# Short-side cap in px (4K -> 1080p); 0 = keep resolution
OVERSIZE_MAX_SIDE=1080
OVERSIZE_AUDIO_BITRATE=192k
MAX_WATERMARK_MB=5
MAX_WATERMARK_PX=2000
MAX_CONCURRENT=1
MAX_PLAYLIST_ITEMS=50
MAX_QUEUE_SIZE=100
MAX_USER_QUEUE=10
CLEANER_AGE_HOURS=12

# Weak-server protection (1 CPU / 10 GB disk)
MIN_FREE_DISK_MB=1500
MAX_VIDEO_MINUTES=30
CLEANER_INTERVAL_MIN=15
# telegram-bot-api --dir (see deploy/server_setup.sh output); the bot cleans it
LOCAL_BOT_API_DIR=
LOCAL_BOT_API_FILE_TTL_MIN=60
LOW_PRIORITY_MEDIA=1
