# Required
BOT_TOKEN=
ADMIN_ID=

# Optional
MEDIA_HUNTER_HOME=
LOCAL_BOT_API=http://127.0.0.1:8081
YTDLP_COOKIES=

# Media policy
SOFT_UNIQUE_SIZE_MB=80
MAX_UNIQUE_SIZE_MB=100
# Optional compatibility override; defaults to MAX_UNIQUE_SIZE_MB
MAX_URL_LOGICAL_MB=100
# Absolute safety limit for source downloads
MAX_SOURCE_DOWNLOAD_MB=1536
# Telegram uploads can be larger when using the local Bot API
MAX_USER_UPLOAD_MB=1536
MAX_WATERMARK_MB=5
MAX_WATERMARK_PX=2000
MAX_CONCURRENT=1
MAX_PLAYLIST_ITEMS=50
MAX_QUEUE_SIZE=100
MAX_USER_QUEUE=10
CLEANER_AGE_HOURS=12
